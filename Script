        tipLbl.Font = Enum.Font.Gotham
        tipLbl.TextColor3 = C.TextDim
        tipLbl.TextXAlignment = Enum.TextXAlignment.Left
        tipLbl.Parent = row
    end

    local pill = Instance.new("Frame")
    pill.Size = UDim2.new(0, 38, 0, 20)
    pill.Position = UDim2.new(1, -48, 0.5, -10)
    pill.BackgroundColor3 = C.ToggleOff
    pill.BorderSizePixel = 0
    pill.Parent = row
    corner(pill, 10)

    local knob = Instance.new("Frame")
    knob.Size = UDim2.new(0, 16, 0, 16)
    knob.Position = UDim2.new(0, 2, 0.5, -8)
    knob.BackgroundColor3 = Color3.new(1, 1, 1)
    knob.BorderSizePixel = 0
    knob.Parent = pill
    corner(knob, 8)

    local on = false
    local function setToggle(val)
        on = val
        tweenBG(pill, on and C.ToggleOn or C.ToggleOff)
        TweenService:Create(knob, TweenInfo.new(0.15), {
            Position = on
                and UDim2.new(0, 20, 0.5, -8)
                or  UDim2.new(0, 2,  0.5, -8)
        }):Play()
        callback(on)
    end

    local hitbox = Instance.new("TextButton")
    hitbox.Size = UDim2.new(1, 0, 1, 0)
    hitbox.BackgroundTransparency = 1
    hitbox.Text = ""
    hitbox.Parent = row
    hitbox.MouseButton1Click:Connect(function() setToggle(not on) end)

    return row, setToggle
end

