-- Toggle row
local function makeToggle(page, text, tooltip, callback)
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, 0, 0, 40)
    row.BackgroundColor3 = C.Section
    row.BorderSizePixel = 0
    row.Parent = page
    corner(row, 6)

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -60, 1, 0)
    lbl.Position = UDim2.new(0, 12, 0, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text = text
    lbl.TextSize = 13
    lbl.Font = Enum.Font.Gotham
    lbl.TextColor3 = C.Text
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent = row

    if tooltip and tooltip ~= "" then
        local tip = Instance.new("TextLabel")
        tip.Size = UDim2.new(1, -60, 0, 14)
        tip.Position = UDim2.new(0, 12, 1, -16)
        tip.BackgroundTransparency = 1
        tip.Text = tooltip
        tip.TextSize = 10
        tip.Font = Enum.Font.Gotham
        tip.TextColor3 = C.TextDim
        tip.TextXAlignment = Enum.TextXAlignment.Left
        tip.Parent = row
    end

    -- Toggle pill
    local pill = Instance.new("Frame")
    pill.Size = UDim2.new(0, 40, 0, 20)
    pill.Position = UDim2.new(1, -52, 0.5, -10)
    pill.BackgroundColor3 = C.ToggleOff
    pill.BorderSizePixel = 0
    pill.Parent = row
    corner(pill, 10)

    local knob = Instance.new("Frame")
    knob.Size = UDim2.new(0, 16, 0, 16)
    knob.Position = UDim2.new(0, 2, 0.5, -8)
    knob.BackgroundColor3 = Color3.new(1,1,1)
    knob.BorderSizePixel = 0
    knob.Parent = pill
    corner(knob, 8)

    local on = false
    local function setToggle(val)
        on = val
        tweenBG(pill, on and C.ToggleOn or C.ToggleOff)
        TweenService:Create(knob, TweenInfo.new(0.15), {
            Position = on and UDim2.new(0, 22, 0.5, -8) or UDim2.new(0, 2, 0.5, -8)
        }):Play()
        callback(on)
    end

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 1, 0)
    btn.BackgroundTransparency = 1
    btn.Text = ""
    btn.Parent = row
    btn.MouseButton1Click:Connect(function() setToggle(not on) end)

    return row, setToggle
end

