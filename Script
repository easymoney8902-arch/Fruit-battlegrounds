-- ── Helper: make UICorner ─────────────────────────────────────
local function corner(parent, radius)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius or 6)
    c.Parent = parent
end

local function stroke(parent, color, thick)
    local s = Instance.new("UIStroke")
    s.Color = color or C.Border
    s.Thickness = thick or 1
    s.Parent = parent
end

-- ── Helper: make a Label ─────────────────────────────────────
local function label(parent, text, size, color, xAlign)
    local l = Instance.new("TextLabel")
    l.BackgroundTransparency = 1
    l.Size = UDim2.new(1, 0, 0, size + 4)
    l.Text = text
    l.TextSize = size
    l.Font = Enum.Font.GothamBold
    l.TextColor3 = color or C.Text
    l.TextXAlignment = xAlign or Enum.TextXAlignment.Left
    l.Parent = parent
    return l
end

-- ── Helper: tween BG colour ──────────────────────────────────
local function tweenBG(obj, color, t)
    TweenService:Create(obj, TweenInfo.new(t or 0.15), { BackgroundColor3 = color }):Play()
end

-- ── Helper: tween TextColor3 ─────────────────────────────────
local function tweenTxt(obj, color, t)
    TweenService:Create(obj, TweenInfo.new(t or 0.15), { TextColor3 = color }):Play()
end

